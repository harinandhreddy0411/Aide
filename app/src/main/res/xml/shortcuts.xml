        android:shortcutId="speak"
        android:enabled="true"
        android:icon="@drawable/ic_mic_shortcut"
        android:shortcutShortLabel="@string/shortcut_speak"
        android:shortcutLongLabel="@string/shortcut_speak">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.aide.app.MainActivity"
            android:targetPackage="com.aide.app">
